<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration><Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration><Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{A7E3D51C-4F86-42B9-9C0D-5E1B8A26F470}</ProjectGuid>
    <RootNamespace>tclwext4</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <!-- v143 is VS2022's toolset. Fall back to whatever the installed VS
         provides when v143 is not present, so a newer Visual Studio still
         builds this without an edit. -->
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v143</PlatformToolset>
    <PlatformToolset Condition="!Exists('$(VCTargetsPath)') And '$(DefaultPlatformToolset)'!=''">$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>tclwext4</TargetName>
    <!-- TC loads .wfx for 32-bit and .wfx64 for 64-bit, same base name. -->
    <TargetExt Condition="'$(Platform)'=='Win32'">.wfx</TargetExt>
    <TargetExt Condition="'$(Platform)'=='x64'">.wfx64</TargetExt>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(ProjectDir)config;$(ProjectDir)external\lwext4\include;$(SolutionDir)build\fatfs;$(ProjectDir)external\squashfuse\win;$(ProjectDir)external\squashfuse;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!--
        lwext4 configuration lives in config/generated/ext4_config.h, which
        lwext4's own ext4_config.h includes. Do not add CONFIG_* defines here:
        the header is shared by both projects, which is what keeps the static
        library and the DLL agreeing on struct layouts.
      -->
      <PreprocessorDefinitions>UNICODE;_UNICODE;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- 4005: ext4_misc.h redefines offsetof over ucrt stddef.h -->
      <DisableSpecificWarnings>4244;4267;4996;4005;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <WarningLevel>Level3</WarningLevel>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">TCLWEXT4_WFX64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>
      <ModuleDefinitionFile>$(ProjectDir)src\tclwext4.def</ModuleDefinitionFile>
      <AdditionalDependencies>comdlg32.lib;shell32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding Condition="'$(Configuration)'=='Release'">true</EnableCOMDATFolding>
      <OptimizeReferences Condition="'$(Configuration)'=='Release'">true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\tclwext4.c" />
    <ClCompile Include="src\tcl_blockdev.c" />
    <ClCompile Include="src\tcl_scan.c" />
    <ClCompile Include="src\tcl_vol.c" />
    <ClCompile Include="src\tcl_util.c" />
    <ClCompile Include="src\tcl_content.c" />
    <ClCompile Include="src\tcl_dialog.c" />
    <ClCompile Include="src\tcl_fs.c" />
    <ClCompile Include="src\tcl_fs_fat.c" />
    <ClCompile Include="src\tcl_fs_sqfs.c" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="src\tclwext4.rc" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\tclwext4.h" />
    <ClInclude Include="src\version.h" />
    <ClInclude Include="src\tcl_fs.h" />
    <ClInclude Include="src\wfxplugin.h" />
  </ItemGroup>

  <ItemGroup>
    <None Include="src\tclwext4.def" />
    <None Include="pluginst.inf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="lwext4.vcxproj">
      <Project>{6B2F8C1A-9D3E-4A57-8B21-0C4E7F9A1D33}</Project>
    </ProjectReference>
    <ProjectReference Include="fatfs.vcxproj">
      <Project>{C41B7E92-3A5D-4E18-9F62-7D0A5C38B441}</Project>
    </ProjectReference>
    <ProjectReference Include="squashfuse.vcxproj">
      <Project>{9E2C4A17-6B83-4D5F-A012-3C7E91D46B58}</Project>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
